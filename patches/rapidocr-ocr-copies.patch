+TextLine CrnnNet::decodeScores(const float *data, size_t h, size_t w) const {
+    // Same result as scoreToTextLine, including its last-step quirk: the
+    // final time step's scan stops one class short.
+    const size_t keySize = keys.size();
+    const size_t dataSize = h * w;
+    std::string strRes;
+    std::vector<float> scores;
+    size_t lastIndex = 0;
+    for (size_t i = 0; i < h; i++) {
+        const size_t start = i * w;
+        size_t stop = (i + 1) * w;
+        if (stop > dataSize - 1) stop = (i + 1) * w - 1;
+        size_t maxIndex = 0;
+        float maxValue = data[start];
+        for (size_t j = start + 1; j < stop; ++j) {
+            if (data[j] > maxValue) {
+                maxValue = data[j];
+                maxIndex = j - start;
+            }
+        }
+        if (maxIndex > 0 && maxIndex < keySize && (!(i > 0 && maxIndex == lastIndex))) {
+            scores.emplace_back(maxValue);
+            strRes.append(keys[maxIndex]);
+        }
+        lastIndex = maxIndex;
+    }
+    return {strRes, scores};
+}
