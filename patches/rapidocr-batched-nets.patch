+std::vector<TextLine> CrnnNet::getTextLineBatch(const std::vector<cv::Mat> &srcs) {
+    const size_t count = srcs.size();
+    std::vector<cv::Mat> resized(count);
+    int batchWidth = 1;
+    for (size_t i = 0; i < count; ++i) {
+        const float scale = (float) dstHeight / (float) srcs[i].rows;
+        const int dstWidth = (std::max)(1, int((float) srcs[i].cols * scale));
+        cv::resize(srcs[i], resized[i], cv::Size(dstWidth, dstHeight));
+        batchWidth = (std::max)(batchWidth, dstWidth);
+    }
+    const size_t channels = resized.front().channels();
+    const size_t plane = static_cast<size_t>(dstHeight) * batchWidth;
+    // Zero after normalization is mid-grey, the padding PaddleOCR's own
+    // batched recognizer uses.
+    std::vector<float> inputTensorValues(count * channels * plane, 0.0f);
+    for (size_t i = 0; i < count; ++i) {
+        std::vector<float> values = substractMeanNormalize(resized[i], meanValues, normValues);
+        const size_t width = resized[i].cols;
+        for (size_t ch = 0; ch < channels; ++ch) {
+            for (size_t row = 0; row < static_cast<size_t>(dstHeight); ++row) {
+                const float *from = values.data() + ch * dstHeight * width + row * width;
+                float *to = inputTensorValues.data() + (i * channels + ch) * plane + row * batchWidth;
+                std::copy(from, from + width, to);
+            }
+        }
+    }
+    std::array<int64_t, 4> inputShape{static_cast<int64_t>(count), static_cast<int64_t>(channels),
+                                      dstHeight, batchWidth};
+    auto memoryInfo = Ort::MemoryInfo::CreateCpu(OrtDeviceAllocator, OrtMemTypeCPU);
+    Ort::Value inputTensor = Ort::Value::CreateTensor<float>(memoryInfo, inputTensorValues.data(),
+                                                             inputTensorValues.size(), inputShape.data(),
+                                                             inputShape.size());
+    std::vector<const char *> inputNames = {inputNamesPtr.data()->get()};
+    std::vector<const char *> outputNames = {outputNamesPtr.data()->get()};
+    auto outputTensor = session->Run(Ort::RunOptions{nullptr}, inputNames.data(), &inputTensor,
+                                     inputNames.size(), outputNames.data(), outputNames.size());
+    std::vector<int64_t> outputShape = outputTensor[0].GetTensorTypeAndShapeInfo().GetShape();
+    const size_t steps = static_cast<size_t>(outputShape[1]);
+    const size_t classes = static_cast<size_t>(outputShape[2]);
+    const float *floatArray = outputTensor.front().GetTensorMutableData<float>();
+    std::vector<TextLine> textLines;
+    textLines.reserve(count);
+    for (size_t i = 0; i < count; ++i) {
+        const float *first = floatArray + i * steps * classes;
+        std::vector<float> outputData(first, first + steps * classes);
+        textLines.push_back(scoreToTextLine(outputData, steps, classes));
+    }
+    return textLines;
+}
