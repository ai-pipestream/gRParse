+TextLine CrnnNet::decodeReduced(const float *data, size_t h) const {
+    // Each time step holds its best class and that class's score twice: over
+    // every class, and over every class but the last, which is all
+    // decodeScores scans at the final step (scoreToTextLine's quirk).  The
+    // first of equal scores wins on the device as it does there.
+    const size_t keySize = keys.size();
+    std::string strRes;
+    std::vector<float> scores;
+    size_t lastIndex = 0;
+    for (size_t i = 0; i < h; i++) {
+        const float *step = data + i * 4 + (i + 1 == h ? 2 : 0);
+        const size_t maxIndex = static_cast<size_t>(step[0]);
+        const float maxValue = step[1];
+        if (maxIndex > 0 && maxIndex < keySize && (!(i > 0 && maxIndex == lastIndex))) {
+            scores.emplace_back(maxValue);
+            strRes.append(keys[maxIndex]);
+        }
+        lastIndex = maxIndex;
+    }
+    return {strRes, scores};
+}
