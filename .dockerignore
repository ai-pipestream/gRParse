# Keep the service build context lean.  models/ stays IN the context on
# purpose: when the files are present locally, the in-build ctest run executes
# the layout/table/figure goldens instead of skipping them (CI checkouts have
# no models, so those tests skip there either way).
.git/
examples/**/node_modules/
examples/**/.venv/
examples/**/gen/
examples/**/.staged-protos/
examples/clients/go/go
build/
build-*/
corpus-*/
eval/out/
__pycache__/
e2e/**/node_modules/
e2e/out/
e2e/test-results/
# Editor and agent state (review worktrees under .claude/worktrees would
# otherwise ride along as context).
.claude/
