      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (doctype, status) (rate(grparse_documents_completed_total[1m]))",
          "legendFormat": "{{doctype}} ({{status}})",
          "refId": "A"
        }
      ],
      "title": "Document Completion & Error Rate by Doctype",
      "type": "timeseries"
    },
    {
