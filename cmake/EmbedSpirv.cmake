# cmake -DINPUT=<file.spv> -DOUTPUT=<file.cpp> -DSYMBOL=<name> -P cmake/EmbedSpirv.cmake
# Writes the SPIR-V module as grparse::levelzero::<name> and <name>Size.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUTPUT}"
  "// Generated by cmake/EmbedSpirv.cmake from ${INPUT}.\n"
  "#include <cstddef>\n"
  "namespace grparse::levelzero {\n"
  "extern const unsigned char ${SYMBOL}[] = {${bytes}};\n"
  "extern const size_t ${SYMBOL}Size = ${size};\n"
  "}  // namespace grparse::levelzero\n")
