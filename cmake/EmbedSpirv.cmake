# cmake -DINPUT=<file.spv> -DOUTPUT=<file.cpp> -P cmake/EmbedSpirv.cmake
# Writes the SPIR-V module as grparse::levelzero::kSlanetDecoderSpirv.
file(READ "${INPUT}" hex HEX)
string(LENGTH "${hex}" length)
math(EXPR size "${length} / 2")
string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
file(WRITE "${OUTPUT}"
  "// Generated by cmake/EmbedSpirv.cmake from src/levelzero/slanet_decoder.cl.\n"
  "#include <cstddef>\n"
  "namespace grparse::levelzero {\n"
  "extern const unsigned char kSlanetDecoderSpirv[] = {${bytes}};\n"
  "extern const size_t kSlanetDecoderSpirvSize = ${size};\n"
  "}  // namespace grparse::levelzero\n")
