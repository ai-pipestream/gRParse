# syntax=docker/dockerfile:1
# pipestreamai/grparse-models: the model files gRParse loads, fetched from
# their upstreams, pinned by sha256 (models/MANIFEST), the figure classifier
# patched, all under /models. Used as an init container that fills a volume:
#
#   docker build -f Dockerfile.models -t pipestreamai/grparse-models .
#   docker run --rm -v grparse-models:/target pipestreamai/grparse-models
#   docker run -v grparse-models:/models:ro ... pipestreamai/grparse:latest-cpu
#
# compose.stack.models.yaml wires exactly that into the demo stack.
#
# Build args:
#   MODELS_LAYOUT=heron|picodet|all   which layout detector(s) to include
#   MODELS_TOKENIZER=0|1              add chunk/tokenizer.json (hf/1 counter)
#   MODELS_OPENVINO=0|1               add the openvino flavor's IR under
#                                     /models/openvino (built from the
#                                     original models, sha256-checked)
#
# Multi-arch for free: the model bytes are the same on every architecture,
# so the fetch stage runs on the build host's own platform and the final
# stage only copies. Keep the final stage RUN-free: with no RUN there the
# arm64 leg needs no emulation at all.
#
#   docker buildx build --platform linux/amd64,linux/arm64 -f Dockerfile.models .

ARG MODELS_LAYOUT=heron
ARG MODELS_TOKENIZER=0
ARG MODELS_OPENVINO=0

# The fetch Python must be a version onnxruntime ships wheels for
# (cp311-cp314 for 1.31.1 and 1.32.0). scripts/check-models-requirements.sh
# rejects a pin that has no wheel for this version.
FROM --platform=$BUILDPLATFORM dhi.io/python:3.14-debian13-dev@sha256:debbc2a523d09b60d89c0d1f5792609a3cc8840726871b0ca278e9533a6c342e AS fetch
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# onnx rewrites the figure classifier graph; onnxruntime and numpy let the
# patch script score both graphs and refuse a non-identical result. Pinned
# (scripts/models-requirements.txt): an unpinned onnx release could change
# the patched file's bytes and fail its sha256 check with no code change.
COPY scripts/models-requirements.txt /tmp/models-requirements.txt
RUN pip install --no-cache-dir --no-deps -r /tmp/models-requirements.txt
WORKDIR /src
COPY models/MANIFEST models/MANIFEST
COPY scripts/fetch-models.sh scripts/patch_figure_classifier.py scripts/split_slanet.py scripts/
ARG MODELS_LAYOUT
ARG MODELS_TOKENIZER
# Every download is checked against the manifest's sha256 before it is kept;
# the patched classifier is checked the same way, so a different onnx
# serialization fails the build instead of shipping.
RUN set -eu; \
    tokenizer=""; [ "$MODELS_TOKENIZER" = 1 ] && tokenizer=--tokenizer; \
    FETCH_MODELS_PYTHON=python3 scripts/fetch-models.sh --dir /models \
      --layout "$MODELS_LAYOUT" $tokenizer \
    && rm -f /models/figure_classifier_upstream.onnx \
    && cp models/MANIFEST /models/MANIFEST \
    && mkdir -p /target

# The openvino IR, converted from the original models with the pinned
# toolchain (torch has no wheel for the fetch stage's Python), and checked
# file by file against models/MANIFEST by the same fetch script.  With
# MODELS_OPENVINO=0 the stage only leaves an empty directory.
FROM --platform=$BUILDPLATFORM python:3.12-slim@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS openvino-ir
ARG MODELS_OPENVINO
ARG MODELS_LAYOUT
WORKDIR /src
COPY scripts/models-openvino-requirements.txt /tmp/models-openvino-requirements.txt
COPY models/MANIFEST models/MANIFEST
COPY models/openvino models/openvino
COPY scripts/fetch-models.sh scripts/build-openvino-irs.sh scripts/patch_figure_classifier.py scripts/
COPY --from=fetch /models /models
RUN set -eu; mkdir -p /models/openvino; \
    if [ "$MODELS_OPENVINO" = 1 ]; then \
      apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
        && rm -rf /var/lib/apt/lists/* \
        && pip install --no-cache-dir -r /tmp/models-openvino-requirements.txt \
        && pip install --no-cache-dir --index-url https://download.pytorch.org/whl/cpu torch==2.8.0 \
        && FETCH_MODELS_OPENVINO_PYTHON="python3 -I" scripts/fetch-models.sh --dir /models \
             --layout "$MODELS_LAYOUT" --openvino \
        && rm -rf /models/openvino-src; \
    fi

FROM dhi.io/debian-base:trixie-debian13@sha256:5c9d8c2c90a0a4672f44a42a485c99e1b95f4bfad5c8ef49934f34b7ffb6e23b
LABEL org.opencontainers.image.title="grparse-models" \
      org.opencontainers.image.description="Model files for pipestreamai/grparse under /models; run to copy them into a volume" \
      org.opencontainers.image.source="https://github.com/ai-pipestream/gRParse"
# COPY resets ownership to root unless told otherwise; the base runs as
# nonroot (65532), and a named volume mounted at /target takes this
# directory's owner when the container starts, which is what lets that user
# write into it.
COPY --from=fetch --chown=65532:65532 /models /models
COPY --from=openvino-ir --chown=65532:65532 /models/openvino /models/openvino
COPY --from=fetch --chown=65532:65532 /target /target
COPY --chmod=755 scripts/fetch-models.sh scripts/models-populate.sh /usr/local/bin/
ENTRYPOINT ["/usr/local/bin/models-populate.sh"]
CMD ["/target"]
