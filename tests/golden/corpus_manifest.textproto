# proto-file: tests/golden/corpus_manifest.proto
# proto-message: grparse.test.golden.CorpusManifest
#
# Every file under tests/golden/corpus, and what golden-corpus-test holds it
# to: the InputFormat its bytes and name resolve to, the collector the
# default route picks, and where a full golden of its parse can run. The
# test fails when a file here is missing, a file there is not listed, an
# InputFormat value has no fixture, or a fixture resolves or routes to
# anything other than what is stated. Top-level fixtures are the scorecard
# corpus (eval/scorecard/corpus.json); formats/ is regenerated with
# tests/golden/build_format_fixtures.py.

fixtures {
  path: "bar_chart.png"
  format: INPUT_FORMAT_IMAGE
  collector: COLLECTOR_GRPARSE_CV
  full_golden: GOLDEN_TIER_MODELS
  note: "tests/data raster: chart figure"
}
fixtures {
  path: "cdata_svg.html"
  format: INPUT_FORMAT_HTML
  collector: COLLECTOR_MARKUP
  full_golden: GOLDEN_TIER_STACK
  note: "grpc-lol-html sample"
}
