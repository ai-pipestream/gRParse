#!/bin/sh
# Parse one document with the quickstart stack and print the result.
#
#   ./parse FILE [--to md|text|html|json|doctags|yaml]    (default: md)
#
# Starts the stack's services if they are not running yet. The document goes
# in on stdin, so any path on this machine works; the client runs in a
# container from compose.yaml (the `parse` service), nothing is installed here.
set -eu

if [ $# -lt 1 ] || [ "$1" = "-h" ] || [ "$1" = "--help" ]; then
  echo "usage: $0 FILE [--to md|text|html|json|doctags|yaml]" >&2
  exit 64
fi
file=$1
shift
if [ ! -f "$file" ]; then
  echo "parse: no such file: $file" >&2
  exit 66
fi
here=$(cd "$(dirname "$0")" && pwd)
exec docker compose -f "$here/compose.yaml" run --rm -T --quiet-pull parse \
  --filename "$(basename "$file")" "$@" < "$file"
