# syntax=docker/dockerfile:1.27
# Intel build: ONNX Runtime with the OpenVINO execution provider, targeting
# Intel Arc GPUs (Battlemage/Alchemist), integrated graphics, CPUs, and NPUs.
# No CUDA toolchain anywhere in this image.
#
# Run with the render device exposed, and the render node's group added when
# the node is not world-writable on the host (the container runs as 65532):
#   docker run --rm --device /dev/dri --group-add "$(stat -c %g /dev/dri/renderD128)" \
#     -v /path/to/models:/models:ro -p 50051:50051 grparse-openvino
#
# The runtime base is swappable so a hardened base can slot in without a
# Dockerfile change, for example:
#   --build-arg GRPARSE_RUNTIME_IMAGE=<registry>/<hardened x86_64 base with glibc >= 2.43>
# The runtime stage asks nothing of the base beyond glibc (matching or newer
# than the build stage's ubuntu26.04, that is 2.43): no shell, no package
# manager, and no ldconfig run. Every other shared library, the Intel NEO
# OpenCL compute runtime included, ships from the build stage.
#
# Why the default stays ubuntu:26.04 while the CPU image runs on a Docker
# Hardened Image (dhi.io/debian-base:trixie-debian13): Debian 13 carries no
# NEO packages (intel-opencl-icd, libigc2, libigdfcl2 have no trixie
# candidates, checked 2026-09-07), so a trixie build stage could not stage
# the GPU compute runtime, and a binary built on ubuntu 26.04 (glibc 2.43)
# does not load on trixie (glibc 2.41). dhi.io publishes no ubuntu base.
# Intel's own Ubuntu .deb releases of NEO installed onto a trixie build
# stage are the route to a hardened default; the ARG above is the seam.
ARG GRPARSE_RUNTIME_IMAGE=ubuntu:26.04

FROM ubuntu:26.04 AS build
ARG GRPARSE_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${GRPARSE_BUILD_JOBS}

ENV DEBIAN_FRONTEND=noninteractive
# cargo/rustc build the Rust tokenizers crate inside tokenizers-cpp, the
# hybrid chunker's hf/1 counter.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cargo cmake curl g++ git make ninja-build pkg-config rustc xz-utils \
    libfreetype-dev libfontconfig-dev libjpeg-dev libopenjp2-7-dev \
    liblcms2-dev libboost-dev libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# OpenCV is vendored from source instead of taken from the distro: the distro
# imgcodecs links GDAL, and GDAL links the distro poppler, so one process ends
# up loading two poppler majors whose identical C++ symbols interpose across
# versions and shift how pages rasterize. This build carries only the three
# modules the server uses, with no GDAL and the image codecs linked in
# statically, so the binary's library closure holds exactly one poppler.
ARG OPENCV_VERSION=4.14.0
ARG OPENCV_SHA256=ee8fb9b30eb60850431b4656447080e3737b56e45719c92b67f245950609f86e
RUN curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors -o /tmp/opencv.tar.gz "https://github.com/opencv/opencv/archive/refs/tags/${OPENCV_VERSION}.tar.gz" \
 && echo "${OPENCV_SHA256}  /tmp/opencv.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/opencv.tar.gz -C /tmp \
 && cmake -S "/tmp/opencv-${OPENCV_VERSION}" -B /tmp/opencv-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/opencv \
      -DBUILD_LIST=core,imgproc,imgcodecs -DBUILD_SHARED_LIBS=ON \
      -DWITH_GDAL=OFF -DWITH_GTK=OFF -DWITH_QT=OFF -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF \
      -DWITH_V4L=OFF -DWITH_OPENEXR=OFF -DWITH_OPENCL=OFF -DWITH_IPP=OFF \
      -DWITH_JPEG=ON -DWITH_PNG=ON -DWITH_TIFF=ON -DWITH_OPENJPEG=ON \
      -DWITH_WEBP=OFF -DWITH_JASPER=OFF -DWITH_AVIF=OFF \
      -DBUILD_JPEG=ON -DBUILD_PNG=ON -DBUILD_TIFF=ON -DBUILD_OPENJPEG=ON -DBUILD_ZLIB=ON \
      -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_opencv_apps=OFF \
 && cmake --build /tmp/opencv-build --parallel ${GRPARSE_BUILD_JOBS} \
 && cmake --install /tmp/opencv-build \
 && rm -rf /tmp/opencv.tar.gz "/tmp/opencv-${OPENCV_VERSION}" /tmp/opencv-build

# Poppler is vendored from source instead of taken from the distro: ubuntu
# 26.04 ships 26.01.0, which predates the 26.06 thread-safety fixes in annots
# loading (upstream 4aca25d6, 2f10803d) that bit this server on arm64. Only
# the cpp frontend and the splash renderer are built.
ARG POPPLER_VERSION=26.08.0
ARG POPPLER_SHA256=dc906e68cea698109706ac6aa3d2c9d4512fcfcac42d90b8afcda486d1b9abd0
RUN curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors -o /tmp/poppler.tar.xz "https://poppler.freedesktop.org/poppler-${POPPLER_VERSION}.tar.xz" \
 && echo "${POPPLER_SHA256}  /tmp/poppler.tar.xz" | sha256sum -c - \
 && tar -xJf /tmp/poppler.tar.xz -C /tmp \
 && cmake -S "/tmp/poppler-${POPPLER_VERSION}" -B /tmp/poppler-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/poppler -DCMAKE_INSTALL_LIBDIR=lib \
      -DENABLE_CPP=ON -DENABLE_QT5=OFF -DENABLE_QT6=OFF -DENABLE_GLIB=OFF -DENABLE_UTILS=OFF \
      -DENABLE_BOOST=ON -DENABLE_NSS3=OFF -DENABLE_GPGME=OFF -DENABLE_LIBCURL=OFF \
      -DENABLE_LIBTIFF=OFF -DENABLE_LIBOPENJPEG=openjpeg2 -DBUILD_CPP_TESTS=OFF \
      -DBUILD_GTK_TESTS=OFF -DBUILD_QT5_TESTS=OFF -DBUILD_QT6_TESTS=OFF -DBUILD_MANUAL_TESTS=OFF \
 && cmake --build /tmp/poppler-build --parallel ${GRPARSE_BUILD_JOBS} \
 && cmake --install /tmp/poppler-build \
 && rm -rf /tmp/poppler.tar.xz "/tmp/poppler-${POPPLER_VERSION}" /tmp/poppler-build

WORKDIR /src
# Headers and runtime from the same OpenVINO version used by the existing
# ORT provider. The wheel is a ZIP archive; no Python interpreter is needed.
RUN apt-get update && apt-get install -y --no-install-recommends unzip \
 && curl -fsSL --retry 5 -o /tmp/openvino.whl \
    https://files.pythonhosted.org/packages/8a/91/807f4e288969bc696dee2e56d7269abffb56626249642effb8ec2ab7d424/openvino-2025.4.1-20426-cp312-cp312-manylinux2014_x86_64.whl \
 && echo "88f074286d420c1a1a95e7f2ba11109a899f2f3b3fd818cfe1e47ead22cc7e45  /tmp/openvino.whl" | sha256sum -c - \
 && unzip -q /tmp/openvino.whl -d /opt/openvino-sdk \
 && rm /tmp/openvino.whl \
 && rm -rf /var/lib/apt/lists/*
COPY . .
# Separate cache from the CUDA image: different ONNX Runtime package and ABI.
# Two builders that share this cache mount (a developer build and a local CI
# run of the same Dockerfile) can leave each other's object files newer than
# the sources, and ninja then skips a recompile that was needed. Give a
# concurrent builder its own tree: --build-arg GRPARSE_BUILD_CACHE_SCOPE=ci
# suffixes the cache id; the default keeps the existing tree.
ARG GRPARSE_BUILD_CACHE_SCOPE=
# Cache-mounted build trees outlive proto changes, and ninja cannot see a
# COPY-ed proto as newer than a cached generated header, so a content stamp
# decides: any proto change discards the staged and generated trees, which
# forces regeneration; everything else stays warm.
RUN --mount=type=cache,id=grparse-openvino-ubuntu26-grpc1.83.1-ort1.24.1-poppler26.08-cxx23-sessionep2-static1-simdutf9-ocv414-tokcpp1${GRPARSE_BUILD_CACHE_SCOPE},sharing=locked,target=/build \
    export PKG_CONFIG_PATH=/opt/poppler/lib/pkgconfig \
 && PROTO_SUM=$(cat *.proto collectors/*.proto | sha256sum | cut -d' ' -f1) \
 && if [ "$(cat /build/.proto-sum 2>/dev/null)" != "$PROTO_SUM" ]; then \
      rm -rf /build/proto /build/generated && printf '%s' "$PROTO_SUM" > /build/.proto-sum; \
    fi \
 && sh scripts/stamp-sources.sh /build \
 && cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
      -DGRPARSE_WERROR=ON -DGRPARSE_ORT_PACKAGE=openvino \
      -DGRPARSE_EMBED_OPENVINO=ON -DGRPARSE_OPENVINO_ROOT=/opt/openvino-sdk/openvino \
      -DOpenCV_DIR=/opt/opencv/lib/cmake/opencv4 \
 && cmake --build /build --target grparse-server grparse-stream-client grparse-embed-text grparse-tests --parallel ${GRPARSE_BUILD_JOBS} \
 && LD_LIBRARY_PATH=/opt/poppler/lib:/opt/opencv/lib ctest --test-dir /build --output-on-failure -L grparse \
 && mkdir -p /out \
 && cp /build/grparse-server /out/grparse-server \
 && cp /build/grparse-stream-client /out/grparse-stream-client \
 && cp /build/grparse-embed-text /out/grparse-embed-text \
 && cp /build/embedding-model-test /out/grparse-embedding-check \
 && cp /build/embedding-reference-test /out/grparse-embedding-reference \
 && cp -a /build/ort-openvino/onnxruntime/capi /out/ort-libs \
 && cp -a /opt/openvino-sdk/openvino/libs/*.so* /out/ort-libs/

# Stage the runtime library closure. The runtime base is assumed minimal
# (hardened images carry no shell, no package manager, no ldconfig), so every
# shared library the binaries need ships from this stage, except glibc,
# which the base owns because the loader and its libraries are inseparable.
# ONNX Runtime dlopens its provider bridge, the OpenVINO provider dlopens
# the OpenVINO plugins, the GPU plugin dlopens the OpenCL loader, and the
# loader dlopens NEO (libigdrcl, the Intel compute runtime), which in turn
# dlopens the graphics compiler (libigc, libigdfcl). An ldd walk of the
# server alone sees none of that, so the dlopened libraries are walked as
# inputs of their own: the ORT/OpenVINO directory wholesale (and left out
# of the staged set, since the runtime copies that directory as it is), and
# the NEO libraries by SONAME from the packages that own them. NEO stays at
# the path /etc/OpenCL/vendors/intel.icd names.
# The Liberation fonts are poppler's base-14 substitutes: a PDF that uses
# Helvetica/Times/Courier without embedding them renders blank text without
# a metric-compatible substitute, which starves layout detection and page
# previews of pixels. fc-cache prebuilds the fontconfig cache so the
# read-only runtime never tries to write one.
# The font set is pinned rather than inherited: fontconfig substitutes
# whatever it happens to find, so an image that carries a different set
# rasterizes non-embedded text to different pixels than its siblings, and a
# page the images disagree about cannot be compared between them. All three
# images ask for the same fonts explicitly.
# The last line holds this image to the invariant the vendored OpenCV
# exists for: the staged closure contains exactly one libpoppler major.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ocl-icd-libopencl1 intel-opencl-icd fonts-liberation fonts-dejavu-core fontconfig \
    && rm -rf /var/lib/apt/lists/* \
    && fc-cache -f \
    && neo_libs=$(dpkg -L intel-opencl-icd ocl-icd-libopencl1 libigc2 libigdfcl2 libigdgmm12 \
                  | grep -E '\.so\.[0-9]+$') \
    && LD_LIBRARY_PATH=/out/ort-libs:/opt/poppler/lib:/opt/opencv/lib \
       STAGE_KEEP_ON_BASE='^/out/ort-libs/' \
       sh scripts/stage-runtime-closure.sh /out/runtime-libs \
         /out/grparse-server /out/grparse-stream-client /out/grparse-embed-text /out/grparse-embedding-check /out/grparse-embedding-reference /out/ort-libs/*.so* \
         /usr/lib/x86_64-linux-gnu/intel-opencl/libigdrcl.so $neo_libs \
    && for lib in $neo_libs; do cp -L "$lib" /out/runtime-libs/; done \
    && mkdir -p /out/openvino-cache \
    && test "$(ls /out/runtime-libs | grep -cE '^libpoppler\.so\.[0-9]+$')" = 1

# LD_LIBRARY_PATH stands in for ldconfig, and the numeric USER works with or
# without a passwd entry (65532 is the conventional nonroot uid in hardened
# images).
FROM ${GRPARSE_RUNTIME_IMAGE}
ENV GRPARSE_LISTEN_ADDRESS=0.0.0.0:50051 GRPARSE_MODELS_DIR=/models GRPARSE_PAGE_WORKERS=2 \
    GRPARSE_ORT_EP=openvino GRPARSE_OPENVINO_DEVICE=GPU \
    LD_LIBRARY_PATH=/usr/local/lib
COPY --from=build /out/runtime-libs/ /usr/local/lib/
COPY --from=build /out/ort-libs/ /usr/local/lib/
# NEO's OpenCL implementation at the path the ICD registration names.
COPY --from=build /usr/lib/x86_64-linux-gnu/intel-opencl /usr/lib/x86_64-linux-gnu/intel-opencl
COPY --from=build /etc/OpenCL /etc/OpenCL
# Fontconfig's configuration (conf.d links into /usr/share/fontconfig, the
# metric-alias rules included), the Liberation base-14 substitutes, and the
# prebuilt font cache: PDFs with embedded fonts never needed any of this,
# but non-embedded Helvetica/Times/Courier text would otherwise rasterize
# blank, invisible to layout detection and page previews.
COPY --from=build /etc/fonts /etc/fonts
COPY --from=build /usr/share/fontconfig /usr/share/fontconfig
COPY --from=build /usr/share/fonts /usr/share/fonts
COPY --from=build /var/cache/fontconfig /var/cache/fontconfig
# The compiled-kernel cache directory GRPARSE_OPENVINO_CACHE_DIR points at
# in the compose overlay, owned by the runtime user so a named volume
# mounted there inherits an ownership 65532 can write to (Docker seeds a
# fresh named volume from the image's directory, owner included). A bind
# mount does not inherit anything: chown it to 65532 on the host.
COPY --from=build --chown=65532:65532 /out/openvino-cache /var/cache/openvino
COPY --from=build /out/grparse-server /usr/local/bin/grparse-server
COPY --from=build /out/grparse-stream-client /usr/local/bin/grparse-stream-client
COPY --from=build /out/grparse-embed-text /usr/local/bin/grparse-embed-text
COPY --from=build /out/grparse-embedding-check /usr/local/bin/grparse-embedding-check
COPY --from=build /out/grparse-embedding-reference /usr/local/bin/grparse-embedding-reference
USER 65532:65532
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/grparse-server"]
