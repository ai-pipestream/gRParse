# syntax=docker/dockerfile:1.27
# CPU build: ONNX Runtime's plain CPU package, the only one Microsoft
# publishes for both x86_64 and aarch64, so this is the image for hosts
# without an NVIDIA or Intel accelerator - Apple Silicon under Docker
# Desktop included. No CUDA or OpenVINO anywhere in this image.
#
#   docker run --rm -v /path/to/models:/models:ro -p 50051:50051 grparse-cpu
#
# The runtime base is swappable so a hardened base can slot in without a
# Dockerfile change, for example:
#   --build-arg GRPARSE_RUNTIME_IMAGE=<registry>/<hardened base with glibc >= 2.43>
# The runtime stage asks nothing of the base beyond glibc (matching or newer
# than the build stage's ubuntu26.04, that is 2.43): no shell, no package
# manager, and no ldconfig run. Every other shared library ships from the
# build stage, and the container runs as the numeric non-root user 65532.
#
# Why the default is still ubuntu:26.04 and not a Docker Hardened Image:
# dhi.io publishes Debian 13 (debian-base:trixie-debian13, glibc 2.41) and
# no ubuntu or gcc image (dhi.io/ubuntu:26.04, debian-base:forky-*, dhi.io/gcc
# do not exist, checked 2026-09-07). A binary built on ubuntu 26.04 does not
# load on glibc 2.41, and building on Debian 13's own toolchain fails: its
# gcc 14 libstdc++ lacks the C++23 "{:?}" format spec the sources use
# (stream_pdf_client.cpp, krick-1 build 2026-09-07). A hardened default
# therefore waits on a base with glibc 2.43 or newer, or on Debian 14.
ARG GRPARSE_RUNTIME_IMAGE=ubuntu:26.04

# The deps stage holds the toolchain and the vendored libraries and nothing
# of this repo, so the weekly sanitizer job (.github/workflows/sanitize.yml)
# builds the sources in exactly the image toolchain.
FROM ubuntu:26.04 AS deps
ARG GRPARSE_BUILD_JOBS=2
ENV CARGO_BUILD_JOBS=${GRPARSE_BUILD_JOBS}

ENV DEBIAN_FRONTEND=noninteractive
# cargo/rustc build the Rust tokenizers crate inside tokenizers-cpp, the
# hybrid chunker's hf/1 counter.
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cargo cmake curl g++ git make ninja-build pkg-config rustc xz-utils \
    libcurl4-openssl-dev \
    && rm -rf /var/lib/apt/lists/*

# OpenCV is vendored from source instead of taken from the distro: the distro
# imgcodecs links GDAL, and GDAL links the distro poppler (GPL), which would
# put a copyleft PDF engine back into this Apache-2.0 image's library
# closure. This build carries only the modules the server uses, with no GDAL
# and the image codecs linked in statically.
ARG OPENCV_VERSION=5.0.0
ARG OPENCV_SHA256=b0528f5a1d379d59d4701cb28c36e22214cc51cf64594e5b56f2d3e6c0233095
RUN curl -fsSL --retry 5 --retry-delay 5 --retry-all-errors -o /tmp/opencv.tar.gz "https://github.com/opencv/opencv/archive/refs/tags/${OPENCV_VERSION}.tar.gz" \
 && echo "${OPENCV_SHA256}  /tmp/opencv.tar.gz" | sha256sum -c - \
 && tar -xzf /tmp/opencv.tar.gz -C /tmp \
 && cmake -S "/tmp/opencv-${OPENCV_VERSION}" -B /tmp/opencv-build -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/opt/opencv \
      -DBUILD_LIST=core,imgproc,imgcodecs,geometry -DBUILD_SHARED_LIBS=ON \
      -DWITH_GDAL=OFF -DWITH_GTK=OFF -DWITH_QT=OFF -DWITH_FFMPEG=OFF -DWITH_GSTREAMER=OFF \
      -DWITH_V4L=OFF -DWITH_OPENEXR=OFF -DWITH_OPENCL=OFF -DWITH_IPP=OFF \
      -DWITH_JPEG=ON -DWITH_PNG=ON -DWITH_TIFF=ON -DWITH_OPENJPEG=ON \
      -DWITH_WEBP=OFF -DWITH_JASPER=OFF -DWITH_AVIF=OFF \
      -DBUILD_JPEG=ON -DBUILD_PNG=ON -DBUILD_TIFF=ON -DBUILD_OPENJPEG=ON -DBUILD_ZLIB=ON \
      -DBUILD_TESTS=OFF -DBUILD_PERF_TESTS=OFF -DBUILD_EXAMPLES=OFF -DBUILD_opencv_apps=OFF \
 && cmake --build /tmp/opencv-build --parallel ${GRPARSE_BUILD_JOBS} \
 && cmake --install /tmp/opencv-build \
 && rm -rf /tmp/opencv.tar.gz "/tmp/opencv-${OPENCV_VERSION}" /tmp/opencv-build

FROM deps AS build
ARG GRPARSE_BUILD_JOBS=2
# CI fills models/ in the build context and passes 1, so the in-build ctest
# fails on a missing model instead of skipping the model-backed goldens.
ARG GRPARSE_TEST_REQUIRE_MODELS=0
WORKDIR /src
COPY . .
# Separate cache from the CUDA and OpenVINO images: different ONNX Runtime
# package and ABI. The id is suffixed per target architecture because the
# multi-platform legs build concurrently and would otherwise share (and
# corrupt) one /build tree. The 3000s test ceiling exists for the emulated
# arm64 leg; native builds finish each test in seconds.
ARG TARGETARCH
# Two builders that share this cache mount (a developer build and a local CI
# run of the same Dockerfile) can leave each other's object files newer than
# the sources, and ninja then skips a recompile that was needed. Give a
# concurrent builder its own tree: --build-arg GRPARSE_BUILD_CACHE_SCOPE=ci
# suffixes the cache id; the default keeps the existing tree.
ARG GRPARSE_BUILD_CACHE_SCOPE=
# Cache-mounted build trees outlive proto changes, and ninja cannot see a
# COPY-ed proto as newer than a cached generated header, so a content stamp
# decides: any proto change discards the staged and generated trees, which
# forces regeneration; everything else stays warm.
RUN --mount=type=cache,id=grparse-cpu-ubuntu26-grpc1.84.0-ort1.30.0-cxx23-sessionep2-static1-simdutf9-ocv500-tokcpp1-${TARGETARCH}${GRPARSE_BUILD_CACHE_SCOPE},sharing=locked,target=/build \
    PROTO_SUM=$(cat *.proto collectors/*.proto | sha256sum | cut -d' ' -f1) \
 && if [ "$(cat /build/.proto-sum 2>/dev/null)" != "$PROTO_SUM" ]; then \
      rm -rf /build/proto /build/generated && printf '%s' "$PROTO_SUM" > /build/.proto-sum; \
    fi \
 && sh scripts/stamp-sources.sh /build \
 && cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
      -DGRPARSE_WERROR=ON -DGRPARSE_ORT_PACKAGE=cpu -DGRPARSE_TEST_TIMEOUT=3000 \
      -DOpenCV_DIR=/opt/opencv/lib/cmake/opencv5 \
 && cmake --build /build --target grparse-server grparse-stream-client grparse-embed-text grparse-tests --parallel ${GRPARSE_BUILD_JOBS} \
 && LD_LIBRARY_PATH=/opt/opencv/lib ctest --test-dir /build --output-on-failure -L grparse \
 && mkdir -p /out \
 && cp /build/grparse-server /out/grparse-server \
 && cp /build/grparse-stream-client /out/grparse-stream-client \
 && cp /build/grparse-embed-text /out/grparse-embed-text \
 && cp /build/embedding-model-test /out/grparse-embedding-check \
 && cp /build/embedding-reference-test /out/grparse-embedding-reference \
 && cp -a /build/_deps/onnxruntime-src/lib /out/ort-libs

# Stage the runtime library closure. The runtime base is minimal (no shell
# needed, no package manager, no ldconfig), so every shared library the
# binaries need ships from this stage, except glibc, which the base owns
# because the loader and its libraries are inseparable. ONNX Runtime's
# provider bridge is dlopened, so it is walked as an input of its own; the
# ONNX Runtime directory is copied wholesale below, so the walk leaves it
# out instead of staging a second copy of each library under its SONAME.
# The last line holds this image to the invariant the vendored OpenCV
# exists for: no poppler in the staged closure.
RUN LD_LIBRARY_PATH=/out/ort-libs:/opt/opencv/lib \
       STAGE_KEEP_ON_BASE='^/out/ort-libs/' \
       sh scripts/stage-runtime-closure.sh /out/runtime-libs \
         /out/grparse-server /out/grparse-stream-client /out/grparse-embed-text /out/grparse-embedding-check /out/grparse-embedding-reference /out/ort-libs/*.so* \
    && test "$(ls /out/runtime-libs | grep -c '^libpoppler')" = 0

# LD_LIBRARY_PATH stands in for ldconfig, and the numeric USER works with or
# without a passwd entry (65532 is the conventional nonroot uid in hardened
# images).
FROM ${GRPARSE_RUNTIME_IMAGE}
# The layout model is the same one the CUDA and OpenVINO images run, so a
# document parses to the same items on every accelerator: measured on a real
# corpus, the lighter picodet detector left a receipt as one word per
# paragraph while heron on the CPU provider was byte-identical to the GPU
# legs at about 2.2x the latency (eval/RESULTS-2026-08-29.md). Speed over
# parity is still one flip away: GRPARSE_LAYOUT_MODEL=picodet.
ENV GRPARSE_LISTEN_ADDRESS=0.0.0.0:50051 GRPARSE_MODELS_DIR=/models GRPARSE_PAGE_WORKERS=2 \
    GRPARSE_ORT_EP=cpu \
    GRPARSE_LAYOUT_MODEL=heron \
    LD_LIBRARY_PATH=/usr/local/lib
COPY --from=build /out/runtime-libs/ /usr/local/lib/
COPY --from=build /out/ort-libs/ /usr/local/lib/
COPY --from=build /out/grparse-server /usr/local/bin/grparse-server
COPY --from=build /out/grparse-stream-client /usr/local/bin/grparse-stream-client
COPY --from=build /out/grparse-embed-text /usr/local/bin/grparse-embed-text
COPY --from=build /out/grparse-embedding-check /usr/local/bin/grparse-embedding-check
COPY --from=build /out/grparse-embedding-reference /usr/local/bin/grparse-embedding-reference
USER 65532:65532
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/grparse-server"]
