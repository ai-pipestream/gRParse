# syntax=docker/dockerfile:1.26
# CPU build: ONNX Runtime's plain CPU package, the only one Microsoft
# publishes for both x86_64 and aarch64, so this is the image for hosts
# without an NVIDIA or Intel accelerator - Apple Silicon under Docker
# Desktop included. No CUDA or OpenVINO anywhere in this image.
#
#   docker run --rm -v /path/to/models:/models:ro -p 50051:50051 grparse-cpu
FROM ubuntu:26.04 AS build

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates cmake g++ git make ninja-build pkg-config libopencv-dev libpoppler-cpp-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY . .
# Separate cache from the CUDA and OpenVINO images: different ONNX Runtime
# package and ABI. The id is suffixed per target architecture because the
# multi-platform legs build concurrently and would otherwise share (and
# corrupt) one /build tree. The 3000s test ceiling exists for the emulated
# arm64 leg; native builds finish each test in seconds.
ARG TARGETARCH
RUN --mount=type=cache,id=grparse-cpu-ubuntu26-grpc1.83.0-ort1.28.0-sessionep1-static1-${TARGETARCH},target=/build \
    cmake -S . -B /build -G Ninja -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=ON \
      -DGRPARSE_WERROR=ON -DGRPARSE_ORT_PACKAGE=cpu -DGRPARSE_TEST_TIMEOUT=3000 \
 && cmake --build /build --target grparse-server grparse-stream-client grparse-tests --parallel 4 \
 && ctest --test-dir /build --output-on-failure -L grparse \
 && mkdir -p /out \
 && cp /build/grparse-server /out/grparse-server \
 && cp /build/grparse-stream-client /out/grparse-stream-client \
 && cp -a /build/_deps/onnxruntime-src/lib /out/ort-libs

FROM ubuntu:26.04
ENV GRPARSE_LISTEN_ADDRESS=0.0.0.0:50051 GRPARSE_MODELS_DIR=/models GRPARSE_PAGE_WORKERS=2 \
    GRPARSE_ORT_EP=cpu
# fonts-liberation gives poppler metric-compatible base-14 substitutes so
# non-embedded Helvetica/Times/Courier text rasterizes instead of rendering
# blank (layout detection and page previews read those pixels).
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpoppler-cpp3 libopencv-core-dev libopencv-imgcodecs-dev libopencv-imgproc-dev \
    fonts-liberation fontconfig \
    && rm -rf /var/lib/apt/lists/* && fc-cache -f
COPY --from=build /out/grparse-server /usr/local/bin/grparse-server
COPY --from=build /out/grparse-stream-client /usr/local/bin/grparse-stream-client
COPY --from=build /out/ort-libs/ /usr/local/lib/
# ldconfig materializes the SONAME link (libonnxruntime.so.1).
RUN ldconfig
EXPOSE 50051
ENTRYPOINT ["/usr/local/bin/grparse-server"]
